ARG NGINX_RUNTIME_IMAGE
FROM ${NGINX_RUNTIME_IMAGE}
ARG NGINX_RUNTIME_IMAGE
RUN case "$NGINX_RUNTIME_IMAGE" in *@sha256:*) ;; *) echo 'Pin the Nginx image by digest' >&2; exit 1 ;; esac
COPY deploy/nginx.conf /etc/nginx/nginx.conf
COPY admin-ui/dist/ /usr/share/nginx/html/
USER 10001:10001
EXPOSE 8080 8443
ENTRYPOINT ["nginx", "-g", "daemon off;"]
