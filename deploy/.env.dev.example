CYYS_API_IMAGE=cyys-framework-api:dev-initial
CYYS_WEB_IMAGE=cyys-framework-web:dev-initial
CYYS_JAVA_RUNTIME_IMAGE=eclipse-temurin:25-jre@sha256:REPLACE_WITH_APPROVED_DIGEST
CYYS_NGINX_RUNTIME_IMAGE=nginx:stable@sha256:REPLACE_WITH_APPROVED_DIGEST
CYYS_ENV=development
CYYS_DB_URL=jdbc:mysql://host.docker.internal:3306/cyys_frame?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai
CYYS_DB_USERNAME=REPLACE_WITH_EXISTING_ACCOUNT
CYYS_DB_PASSWORD_FILE=C:/cyys-dev/secrets/db-password
CYYS_REDIS_HOST=host.docker.internal
CYYS_REDIS_PORT=6379
CYYS_REDIS_DATABASE=0
CYYS_REDIS_PASSWORD_FILE=C:/cyys-dev/secrets/redis-password
CYYS_FILE_ROOT=C:/cyys-dev/private-files
CYYS_TLS_CERTIFICATE_FILE=C:/cyys-dev/secrets/tls.crt
CYYS_TLS_KEY_FILE=C:/cyys-dev/secrets/tls.key
CYYS_BIND_ADDRESS=127.0.0.1
