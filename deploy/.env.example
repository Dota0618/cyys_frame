# Copy outside the repository; choose actual approved image digests before building.
CYYS_API_IMAGE=cyys-framework-api:RELEASE_COMMIT
CYYS_WEB_IMAGE=cyys-framework-web:RELEASE_COMMIT
CYYS_JAVA_RUNTIME_IMAGE=eclipse-temurin:25-jre@sha256:REPLACE_WITH_APPROVED_DIGEST
CYYS_NGINX_RUNTIME_IMAGE=nginx:stable@sha256:REPLACE_WITH_APPROVED_DIGEST
CYYS_ENV=production
CYYS_DB_URL=jdbc:mysql://db.internal:3306/cyys_frame?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai
CYYS_DB_USERNAME=cyys_runtime
CYYS_DB_PASSWORD_FILE=/etc/cyys/secrets/db-password
CYYS_REDIS_HOST=redis.internal
CYYS_REDIS_PORT=6379
CYYS_REDIS_DATABASE=0
CYYS_REDIS_PASSWORD_FILE=/etc/cyys/secrets/redis-password
CYYS_FILE_ROOT=/srv/cyys/private-files
CYYS_TLS_CERTIFICATE_FILE=/etc/cyys/secrets/tls-fullchain.crt
CYYS_TLS_KEY_FILE=/etc/cyys/secrets/tls.key
CYYS_BIND_ADDRESS=0.0.0.0
