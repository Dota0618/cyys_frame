root = true

[*]
charset = utf-8
end_of_line = crlf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 160

[*.{yml,yaml,json,md,html,xml}]
indent_size = 2

[*.{java,kt,ts,tsx,js,jsx,vue}]
indent_size = 4

[*.{properties,conf,ini}]
indent_size = 4

[Makefile]
indent_style = tab

[*.sh]
end_of_line = lf
indent_size = 4

[*.{bat,cmd,ps1}]
end_of_line = crlf
indent_size = 4

[*.md]
trim_trailing_whitespace = false
